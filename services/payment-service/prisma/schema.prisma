generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_PAYMENT")
  schemas  = ["payment_svc"]
}

model PaymentOrder {
  id           String               @id @default(uuid())
  orderId      String               @unique @map("order_id")
  userId       String               @map("user_id")
  workshopSlug String               @map("workshop_slug")
  amount       Int                  // In smallest currency unit (e.g. paise: 49900 = 499 INR)
  currency     String               @default("INR")
  status       String               @default("CREATED") // CREATED, ATTEMPTED, PAID, FAILED, CANCELLED, REFUNDED
  receipt      String               @unique
  notesJson    Json?                @map("notes_json")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  transactions PaymentTransaction[]

  @@map("payment_orders")
  @@schema("payment_svc")
}

model PaymentTransaction {
  id               String       @id @default(uuid())
  orderId          String       @map("order_id")
  paymentId        String       @unique @map("payment_id")
  signature        String?
  method           String?      // upi, card, netbanking, wallet
  status           String       // captured, failed, refunded
  amount           Int
  currency         String       @default("INR")
  errorCode        String?      @map("error_code")
  errorDescription String?      @map("error_description")
  createdAt        DateTime     @default(now()) @map("created_at")
  order            PaymentOrder @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("payment_transactions")
  @@schema("payment_svc")
}

model WebhookEvent {
  id          String   @id // Razorpay event ID for strict deduplication
  eventType   String   @map("event_type")
  payloadJson Json     @map("payload_json")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
  @@schema("payment_svc")
}

model WorkshopPricing {
  id           String   @id @default(uuid())
  workshopSlug String   @unique @map("workshop_slug")
  amount       Int      // Default price in smallest currency unit (e.g. 49900 = 499 INR)
  currency     String   @default("INR")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("workshop_pricing")
  @@schema("payment_svc")
}
