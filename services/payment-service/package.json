{
  "name": "payment-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -b && node -e \"const fs=require('fs'); if(fs.existsSync('src/generated')) { try { fs.cpSync('src/generated', 'dist/generated', {recursive: true, force: true}); } catch {} }\"",
    "start": "node dist/main.js",
    "dev": "node ../../tools/dev-runner.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@app/auth": "workspace:*",
    "@app/common": "workspace:*",
    "@app/contracts": "workspace:*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.4.1",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
