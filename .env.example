# API Gateway & URLs
API_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Service Ports
PORT_API_GATEWAY=4000
PORT_CATALOG=4001
PORT_STARTER=4002
PORT_VERIFICATION=4003
PORT_PROGRESS=4004
PORT_REALTIME=4005

# Service Targets for Gateway Proxy
