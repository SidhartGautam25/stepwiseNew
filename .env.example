# Root Environment Reference

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-minimum-32-chars-long!
SUPABASE_JWKS_URI=http://localhost:54321/auth/v1/.well-known/jwks.json

# API Gateway & URLs
API_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Service Ports
PORT_API_GATEWAY=4000
PORT_CATALOG=4001
PORT_STARTER=4002
PORT_VERIFICATION=4003
PORT_PROGRESS=4004
PORT_REALTIME=4005

# Service Targets for Gateway Proxy
CATALOG_SERVICE_URL=http://localhost:4001
STARTER_SERVICE_URL=http://localhost:4002
VERIFICATION_SERVICE_URL=http://localhost:4003
PROGRESS_SERVICE_URL=http://localhost:4004
REALTIME_SERVICE_URL=http://localhost:4005

# Databases (schema separated)
DATABASE_URL_CATALOG=postgresql://handrail:handrail_password@localhost:5432/handrail_db?schema=catalog
DATABASE_URL_STARTER=postgresql://handrail:handrail_password@localhost:5432/handrail_db?schema=starter
DATABASE_URL_VERIFICATION=postgresql://handrail:handrail_password@localhost:5432/handrail_db?schema=verification
DATABASE_URL_PROGRESS=postgresql://handrail:handrail_password@localhost:5432/handrail_db?schema=progress

# RabbitMQ
RABBITMQ_URL=amqp://handrail:handrail_password@localhost:5672

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_STARTERS=starters
S3_REGION=us-east-1

# Internal CI & Sync Token
INTERNAL_SYNC_TOKEN=dev_internal_sync_token_secret
