# Handrail Web App Environment Variables

# Base URL of the API Gateway as seen by the browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base URL of the API Gateway as seen by the Next.js server (e.g. inside Docker or internal network)
API_INTERNAL_URL=http://localhost:4000

# Name of the access token cookie (__Secure-hr_at for production HTTPS, hr_at for local HTTP)
AUTH_ACCESS_COOKIE_NAME=hr_at

# Web application public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
